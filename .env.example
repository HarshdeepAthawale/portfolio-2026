# Optional Upstash Redis for local/Node hosting. On Cloudflare, storage is the D1 database
# bound as DB (see wrangler.jsonc), so these are not needed there.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Spotify "Now Playing" (optional — without these, the card shows the static
# track in src/config/spotify.ts). Setup:
#   1. Create an app at https://developer.spotify.com/dashboard
#   2. Add redirect URI: http://127.0.0.1:8888/callback
#   3. Copy Client ID + Client Secret below
#   4. Run: node scripts/get-spotify-refresh-token.mjs  → paste the printed token
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# GitHub token (read-only is enough) for the GitHub stats on the About page.
GITHUB_TOKEN=
